<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Qutre3D</RootNamespace>
    <AssemblyName>Qutre3D</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Product>Qutre 3D</Product>
    <AssemblyTitle>Qutre 3D</AssemblyTitle>
    <Description>Atmospheric 3D world editor</Description>
    <Company>Qutre 3D</Company>
    <Version>0.3.0</Version>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo.png" Link="assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\**\*.ttf" Link="assets\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

</Project>
